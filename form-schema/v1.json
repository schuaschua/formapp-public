{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:formapp:form-schema:v1",
  "title": "formapp life insurance proposal, version 1",
  "type": "object",
  "properties": {
    "N1": {
      "title": "What type of product are you looking for?",
      "type": "string",
      "enum": [
        "life",
        "life_health",
        "health"
      ],
      "x-labels": {
        "life": "Life",
        "life_health": "Life + Health",
        "health": "Health"
      },
      "x-page": 1,
      "x-fill": "ask",
      "x-checklist-label": "Type of cover"
    },
    "N2": {
      "title": "What is your approximate annual budget for premiums?",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100000000,
      "x-page": 1,
      "x-fill": "ask",
      "x-checklist-label": "Yearly budget"
    },
    "N3": {
      "title": "Should the policy cover your dependents?",
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "x-page": 1,
      "x-fill": "ask",
      "x-checklist-label": "Dependents"
    },
    "N4": {
      "title": "How many dependents?",
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "x-page": 1,
      "x-fill": "ask",
      "x-checklist-label": "Number of dependents"
    },
    "N5": {
      "title": "Desired coverage amount (sum assured)",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100000000,
      "x-page": 1,
      "x-fill": "infer"
    },
    "N6": {
      "title": "Have you used tobacco or nicotine products in the last 12 months?",
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "x-page": 1,
      "x-fill": "ask",
      "x-checklist-label": "Tobacco use"
    },
    "N7": {
      "title": "Type and daily amount of tobacco/nicotine",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "x-page": 1,
      "x-fill": "ask",
      "x-checklist-label": "Tobacco type and amount"
    },
    "N8": {
      "title": "Is the insured planning a pregnancy in the next 12 months?",
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "x-page": 1,
      "x-fill": "ask",
      "x-checklist-label": "Pregnancy plans"
    },
    "P1": {
      "title": "Selected product",
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "x-page": 2,
      "x-fill": "infer"
    },
    "P2": {
      "title": "Optional riders",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "uniqueItems": true,
      "x-page": 2,
      "x-fill": "infer"
    },
    "P3": {
      "title": "Policy term",
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "x-page": 2,
      "x-fill": "infer"
    },
    "Y1": {
      "title": "Payment frequency",
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "x-labels": {
        "monthly": "Monthly",
        "yearly": "Yearly"
      },
      "x-page": 3,
      "x-fill": "infer"
    },
    "Y2": {
      "title": "Payment method",
      "type": "string",
      "enum": [
        "credit_card",
        "direct_debit"
      ],
      "x-labels": {
        "credit_card": "Credit card",
        "direct_debit": "Direct debit"
      },
      "x-page": 3,
      "x-fill": "infer"
    },
    "Y3": {
      "title": "Is the premium payer different from the insured?",
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "x-page": 3,
      "x-fill": "default",
      "x-simple": true
    },
    "C1": {
      "title": "First name",
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "x-page": 4,
      "x-fill": "db",
      "x-checklist-label": "First name"
    },
    "C13": {
      "title": "Last name",
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "x-page": 4,
      "x-fill": "db",
      "x-checklist-label": "Last name"
    },
    "C2": {
      "title": "Date of birth",
      "type": "string",
      "format": "date",
      "x-age-range": {
        "min": 18,
        "max": 70
      },
      "x-page": 4,
      "x-fill": "db",
      "x-checklist-label": "Date of birth"
    },
    "C3": {
      "title": "Sex at birth",
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
