# Build context for api/Dockerfile, which is the repository root (Story 1.4). An allowlist: only
# what the image needs goes into the upload and the image, so no secrets, state or tests can.
*
!api/pyproject.toml
!api/uv.lock
!api/alembic.ini
!api/migrations/
!api/domain/
!api/adapters/
!api/jobs/
!form-schema/v*.json
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/security-headers.ts
!web/src/
!web/tools/

# Never inside those folders either.
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
web/src/**/*.test.ts
web/src/**/*.test.tsx
web/src/tests
